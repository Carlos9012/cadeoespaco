# Credenciais do Turso (obtidas com:
#   turso db show --url cadeoespaco-db
#   turso db tokens create cadeoespaco-db )
TURSO_DATABASE_URL="libsql://cadeoespaco-db-<seu-usuario>.turso.io"
TURSO_AUTH_TOKEN="<seu-token-aqui>"

# Ambiente local (SQLite em arquivo) — alternativa para desenvolvimento
# TURSO_DATABASE_URL="file:local.db"
# TURSO_AUTH_TOKEN=""

# JWT (preparado para autenticação futura)
JWT_SECRET="troque-este-segredo-em-producao"
JWT_ALGORITHM="HS256"
JWT_EXPIRA_MINUTOS=480